{
    "name": "@hinekora/site",
    "version": "0.0.0",
    "private": true,
    "description": "The hinekora website: landing page, documentation and the playground, as static pages.",
    "type": "module",
    "scripts": {
        "prepare-content": "node scripts/prepare.mjs",
        "dev": "node scripts/prepare.mjs && vitepress dev",
        "build": "node scripts/prepare.mjs && vitepress build",
        "preview": "vitepress preview",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "@hinekora/core": "workspace:*"
    },
    "devDependencies": {
        "@hinekora/playground": "workspace:*",
        "vitepress": "1.6.4",
        "vue": "^3.5.13"
    }
}
