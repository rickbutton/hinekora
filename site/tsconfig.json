{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "./dist/types",
        "emitDeclarationOnly": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"]
    },
    "include": [".vitepress/**/*.ts", ".vitepress/**/*.mts"],
    "exclude": ["dist", ".vitepress/cache", ".vitepress/dist"]
}
