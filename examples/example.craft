craft in poe1

item {
    base:     "Vaal Regalia"
    ilvl:     84
    rarity:   normal
}

transmute
regal

until has "fire res" t1 or has "cold res" t1 or has "light res" t1 {
    annul
    exalt
}

def hasTwoEleRes() =
    (has "fire res" t1 and has "cold res" t1)
    or (has "fire res" t1 and has "light res" t1)
    or (has "cold res" t1 and has "light res" t1)

until hasTwoEleRes() {
    annul
    exalt
}

# A transmute lays down one or two modifiers, so the item may still hold a
# third, unknown one; the bench is safe only once the prefix side is proven open.
if prefixCount == 0 {
    bench "maximum life"
}