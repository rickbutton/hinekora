craft in poe1

item {
    base:     "Vaal Regalia"
    ilvl:     84
    rarity:   normal
}

transmute
regal

until has "fire res" t1 or has "cold res" t1 or has "light res" t1 {
    annul
    exalt
}

def hasTwoEleRes() =
    (has "fire res" t1 and has "cold res" t1)
    or (has "fire res" t1 and has "light res" t1)
    or (has "cold res" t1 and has "light res" t1)

until hasTwoEleRes() {
    annul
    exalt
}
