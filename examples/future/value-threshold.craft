# WAITS ON: modifier value predicates and the Divine Orb (feature-report.md B2).
#
# Finishing a ring: the life roll is tier 1 but the guide wants 75 or more of
# its 70–79 span, so it divines until the roll is in range. A threshold inside
# a tier is the most common stop condition the language cannot state today.

item {
    base:     "Amethyst Ring"
    ilvl:     84
    rarity:   rare
    prefixes: [ "maximum life" t1 ]
    suffixes: [ "fire resistance" t1, "cold resistance" t1, "chaos resistance" t1 ]
}

until has "maximum life" >= 75 {
    divine
}
