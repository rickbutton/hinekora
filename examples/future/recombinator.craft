# WAITS ON: a second item (feature-report.md B4).
#
# The 3.25+ weapon route: two Magic wands, each rolled to one wanted prefix,
# recombined into one carrying both. The proposed spelling binds the second
# item to a name and consumes both; the result's prefixes are drawn from the
# union of the two inputs under the wiki's count and exclusive-modifier rules.

item {
    base:     "Imbued Wand"
    ilvl:     84
    rarity:   magic
    prefixes: [ "level of all spell skill gems" t1 ]
}

with donor {
    base:     "Imbued Wand"
    ilvl:     84
    rarity:   magic
    prefixes: [ "level of all fire spell skill gems" t1 ]
}

until has "level of all spell skill gems" and has "level of all fire spell skill gems" {
    recombine donor
}
