# WAITS ON: feature-report.md A6 (the Harvest augment after an imprint loop).
#
# A +1 gems amulet: imprint as a checkpoint, regal under a prefix lock.
#
# The amulet is rolled Magic until +1 to Level of all Skill Gems sits alone,
# then imprinted at the Bestiary. "Prefixes Cannot Be Changed" fills the
# suffix side, so a Regal Orb can only add a suffix if there is room... but
# with the metamod and the prefix the item holds two mods and the regal may
# add either side. A regal that lands as a second prefix wastes the lock and
# the guide restores the imprint and tries again. Once the suffix is in, the
# metamod protects the prefixes through a Harvest augment, the multimod, and
# the final exalt.

item {
    base:   "Turquoise Amulet"
    ilvl:   84
    rarity: normal
}

transmute
until has "level of all skill gems" and suffixCount == 0 and prefixCount == 1 {
    alteration
}

beast imprint
regal
# A regal that lands as a second prefix wastes the lock: back to the imprint.
until prefixCount == 1 {
    restore
    beast imprint
    regal
}

bench "prefixes cannot be changed"
harvest augment "physical"
bench "can have up to 3 crafted modifiers"
bench "strength and dexterity"
exalt
