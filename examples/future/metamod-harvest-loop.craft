# WAITS ON: an inner loop analysed from the outer loop's joined invariant, and the same group check (checker-findings.md B10, B9).
#
# Lock one side, reforge the other: the Harvest loop behind most finished rares.
#
# "Suffixes Cannot Be Changed" is itself a crafted prefix; a Harvest reforge
# that includes a Life modifier then rerolls only the prefixes, and the metamod
# goes with them. The guide repeats bench + reforge until the life roll is at
# the tier it wants with a prefix still open for the bench. When the three
# prefixes fill with a bad life roll, there is no slot for the metamod, so the
# loop spends an annul before it can go round again.

item {
    base:     "Vermillion Ring"
    ilvl:     84
    rarity:   rare
    prefixes: [ "random" ]
    suffixes: [ "fire resistance" t1, "cold resistance" t1, "chaos resistance" t2 ]
}

until has "maximum life" t1 and prefixCount <= 2 {
    until prefixCount <= 2 {
        annul
    }
    bench "suffixes cannot be changed"
    harvest reforge "life"
}

bench "maximum mana"
