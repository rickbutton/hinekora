# WAITS ON: feature-report.md A4 (naming the metamod the Matron added).
#
# The Wild Bristle Matron trick: a random metamod made deterministic.
#
# The Bestiary recipe adds one of the five metamods at random, among those that
# fit. Four of them are suffixes; only "Suffixes Cannot Be Changed" is a
# prefix. Fill the suffixes first and the recipe has one choice left, so the
# checker proves which metamod the item carries and the reforge that follows
# is known to keep the suffixes.

item {
    base:     "Titan Greaves"
    ilvl:     86
    rarity:   rare
    prefixes: [ "maximum life" t1 ]
    suffixes: [ "fire resistance" t1, "cold resistance" t1, "chaos resistance" t2 ]
}

beast metamod
harvest reforge "speed"
bench "maximum mana"
