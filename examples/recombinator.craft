# The 3.25+ weapon route: two Magic wands, each rolled to one wanted prefix,
# recombined into one carrying both. The second item is the kind of wand the
# guide rolls for each attempt; the result's prefixes are drawn from both under
# the Recombinator's count and exclusive-modifier rules, so the loop reads as
# the guide does: recombine until both sit on one wand.

item {
    base:     "Imbued Wand"
    ilvl:     84
    rarity:   magic
    prefixes: [ "level of all spell skill gems" t1 ]
}

with donor {
    base:     "Imbued Wand"
    ilvl:     84
    rarity:   magic
    prefixes: [ "level of all fire spell skill gems" t1 ]
}

until has "level of all spell skill gems" and has "level of all fire spell skill gems" {
    recombine donor
}
