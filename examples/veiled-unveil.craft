# A veiled prefix under a suffix lock, unveiled until the right option shows.
#
# With the suffixes locked and all three present, a Veiled Exalted Orb must
# add its veiled mod as a prefix; it also removes one unprotected mod, which
# is either the metamod or the life roll. Unveiling offers three of the
# possible prefixes; the guide takes the % life one when it is offered and
# otherwise annuls the unveiled mod away and tries again. An unveiled mod is
# not a crafted mod, so the bench's removal cannot take it, and an
# annul may hit the life or a suffix instead: on those paths the item is
# bricked and the guide stops, so what follows is judged on the paths where
# the item is still worth the next orb.

item {
    base:     "Astral Plate"
    ilvl:     86
    rarity:   rare
    prefixes: [ "maximum life" t1 ]
    suffixes: [ "fire resistance" t2, "cold resistance" t2, "lightning resistance" t2 ]
}

until has "increased maximum life increased maximum mana" {
    bench "suffixes cannot be changed"
    veiled exalt
    # The orb took the life roll instead of the metamod.
    if not has "maximum life" t1 {
        stop
    }
    unveil
    if not has "increased maximum life increased maximum mana" {
        annul
        # The annul took the life or a resistance, not the unveiled mod.
        if not has "maximum life" t1
            or not has "fire resistance"
            or not has "cold resistance"
            or not has "lightning resistance"
        {
            stop
        }
        restart
    }
}

bench "maximum mana"
