#!/bin/sh
# Runs the gate before a push that carries commits to a branch, and refuses the
# push when it fails. `pnpm install` points core.hooksPath here (the `prepare`
# script); `git push --no-verify` skips it.
#
# The gate judges the working tree, so it speaks for the pushed commits only
# when the tree is clean and the pushed commit is the one checked out; the hook
# says so when either is not the case.

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
pushes=0
elsewhere=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
    [ "$local_sha" = "$zero" ] && continue
    pushes=1
    [ "$local_sha" = "$head" ] || elsewhere=1
done
[ "$pushes" = 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1
if [ "$elsewhere" = 1 ]; then
    echo "pre-push: a pushed commit is not the one checked out; the gate runs on this tree." >&2
fi
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "pre-push: the tree has uncommitted changes; the gate runs with them." >&2
fi

log=$(mktemp)
trap 'rm -f "$log"' EXIT
if ! pnpm gate >"$log" 2>&1; then
    tail -n 80 "$log" >&2
    echo "pre-push: the gate failed; the push is refused." >&2
    exit 1
fi
