{
    "name": "hinekora",
    "version": "0.0.0",
    "private": true,
    "description": "hinekora — a statically-checked DSL for Path of Exile crafts",
    "type": "module",
    "packageManager": "pnpm@10.12.4",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || exit 0",
        "build": "tsc -b",
        "clean": "tsc -b --clean",
        "typecheck": "tsc -b",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage --testTimeout 30000 --exclude \"**/src/race.test.ts\" --exclude \"**/src/memory.test.ts\"",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docs:check": "node scripts/check-docs.mjs",
        "prose": "vale sync && pnpm prose:check",
        "prose:check": "node scripts/check-prose.mjs",
        "site:check": "pnpm -C site build",
        "gate": "pnpm typecheck && pnpm test && pnpm lint && pnpm format:check && pnpm docs:check && pnpm site:check && pnpm prose:check"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@vvago/vale",
            "esbuild"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@types/node": "^22.10.5",
        "@vitest/coverage-v8": "^3.0.5",
        "@vvago/vale": "^3.25.1",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "prettier": "^3.4.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "vitest": "^3.0.5"
    }
}
