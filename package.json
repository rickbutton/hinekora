{
    "name": "hinekora",
    "version": "0.0.0",
    "private": true,
    "description": "Hinekora — a statically-checked DSL for Path of Exile crafting guides",
    "type": "module",
    "packageManager": "pnpm@10.12.4",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean",
        "typecheck": "tsc -b",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@types/node": "^22.10.5",
        "@vitest/coverage-v8": "^3.0.5",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "prettier": "^3.4.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "vitest": "^3.0.5"
    }
}
