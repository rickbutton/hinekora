{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "types": ["node"]
    },
    // Project reference to core: `tsc -b` builds core first and this package
    // reads its emitted .d.ts. This is the build-graph edge of the one-way arrow.
    "references": [{ "path": "../core" }],
    "include": ["src/**/*.ts"],
    "exclude": ["dist"]
}
