{
    "name": "@hinekora/cli",
    "version": "0.0.0",
    "private": true,
    "description": "Command-line interface: check a .craft file end to end.",
    "type": "module",
    "bin": {
        "hinekora": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -b",
        "test": "vitest run"
    },
    "dependencies": {
        "@hinekora/core": "workspace:*",
        "@hinekora/data": "workspace:*",
        "@hinekora/parser": "workspace:*"
    }
}
