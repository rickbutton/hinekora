# Hunter exalt a rare, then merge with an elder item via awakener's orb.
item {
    base: "Hubris Circlet" ilvl: 86 rarity: rare
    prefixes: [ "maximum life" t1 ]
    suffixes: [ "fire resistance" t1 ]
}
exalt hunter
awakener elder
if has "nearby enemies have fire resistance" { bench "maximum life" }
