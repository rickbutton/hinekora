# Keep good prefixes, reroll suffixes: prefixes cannot be changed + scour, then re-fill.
item {
    base: "Vaal Regalia" ilvl: 86 rarity: rare
    prefixes: [ "maximum life" t1, "maximum energy shield" t1, "increased energy shield" t2 ]
    suffixes: [ "fire resistance" t5, "random" ]
}
bench "prefixes cannot be changed"
scour
until has "chaos resistance" t1 and has "spell suppression" {
    bench "prefixes cannot be changed"
    harvest reforge "chaos"
}
