# Classic alt-regal: hit +1 gem level on a wand, regal, lock with multimod, bench the rest.
item { base: "Imbued Wand" ilvl: 84 rarity: normal }
transmute
until has "level all spell skill gems" {
    alteration
}
if prefixCount == 1 and suffixCount == 0 { augment }
regal
bench "can have up to 3 crafted modifiers"
bench "spell damage"
bench "critical strike multiplier"
exalt
