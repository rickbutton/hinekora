{
    "//": "Standalone: a VSCode extension is CommonJS, so it does NOT extend the ESM root base.",
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": ["ES2022"],
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "types": ["node", "vscode"]
    },
    "include": ["src/**/*.ts"]
}
