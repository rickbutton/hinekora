{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "hinekora",
    "scopeName": "source.hinekora",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#tiers" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "match": "#.*$",
            "name": "comment.line.number-sign.hinekora"
        },
        "strings": {
            "name": "string.quoted.double.hinekora",
            "begin": "\"",
            "end": "\"",
            "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.hinekora" }]
        },
        "tiers": {
            "match": "\\bt\\d+\\b",
            "name": "constant.numeric.tier.hinekora"
        },
        "numbers": {
            "match": "\\b\\d+\\b",
            "name": "constant.numeric.hinekora"
        },
        "keywords": {
            "patterns": [
                {
                    "match": "\\b(item|with|until|if|else|restart|stop|restore)\\b",
                    "name": "keyword.control.hinekora"
                },
                { "match": "\\b(def)\\b", "name": "storage.type.hinekora" },
                {
                    "match": "\\b(essence|bench|harvest|reforge|augment|randomise|change|veiled|aisling|unveil|foulborn|remove|fossil|beast|add|fracture|metamod|aspect|imprint|awakener|recombine|vaal|locus|tainted|divine|ember|ichor|eldritch|annul|conflict|dominance|prefix|suffix)\\b",
                    "name": "keyword.other.operation.hinekora"
                },
                {
                    "match": "\\b(has|group|fractured|influenced|dominant|not|and|or)\\b",
                    "name": "keyword.other.hinekora"
                },
                {
                    "match": "\\b(isRare|isMagic|isNormal|prefixCount|suffixCount)\\b",
                    "name": "support.function.hinekora"
                },
                {
                    "match": "\\b(base|ilvl|strands|rarity|prefixes|suffixes|influences|corrupted|exarch|eater|enchant)\\b",
                    "name": "variable.parameter.hinekora"
                },
                {
                    "match": "\\b(normal|magic|rare|shaper|elder|crusader|hunter|redeemer|warlord|lesser|greater|grand|exceptional|exquisite|perfect)\\b",
                    "name": "constant.language.hinekora"
                }
            ]
        },
        "operators": {
            "match": "(==|!=|<=|>=|<|>|=|:|,)",
            "name": "keyword.operator.hinekora"
        }
    }
}
